---
layout: null
permalink: /index.json
---
{
  "site": {
    "name": "{{ site.title }}",
    "description": "{{ site.description }}",
    "url": "{{ site.url }}"
  },
  "meta": {
    "generated": "{{ site.time | date_to_xmlschema }}",
    "version": "1.0"
  },
  "statistics": {
    "total_articles": {{ site.guides.size }},
    {%- assign all_tags = site.guides | map: "tags" | join: "," | split: "," | uniq -%}
    "total_topics": {{ all_tags.size }},
    {%- assign dignity = site.guides | where: "category", "dignity" -%}
    {%- assign division = site.guides | where: "category", "division" -%}
    {%- assign unity = site.guides | where: "category", "unity" -%}
    "by_category": {
      "dignity": {{ dignity.size }},
      "division": {{ division.size }},
      "unity": {{ unity.size }}
    }
  },
  "endpoints": {
    "guides": {
      "url": "/api/guides.json",
      "description": "All articles with full metadata"
    },
    "topics": {
      "url": "/api/topics.json",
      "description": "Articles organized by topic tags"
    },
    "feed": {
      "url": "/feed.xml",
      "description": "RSS/Atom feed"
    },
    "sitemap": {
      "url": "/sitemap.xml",
      "description": "XML sitemap"
    },
    "ai_manifest": {
      "url": "/.well-known/ai-site.json",
      "description": "Site discovery manifest"
    }
  },
  "navigation": [
    {
      "label": "Home",
      "url": "/"
    },
    {
      "label": "API Documentation",
      "url": "/api/"
    }
  ]
}
